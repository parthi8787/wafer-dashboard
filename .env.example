# Live ADF / Synapse / Azure SQL (or SQL Server) connection string.
# Server-only — never use a VITE_ / NEXT_PUBLIC_ prefix for this.
# Example:
# ADF_SQL_CONNECTION_STRING=Server=tcp:myserver.database.windows.net,1433;Database=fabops;User ID=readonly;Password=***;Encrypt=true;TrustServerCertificate=false;
#
# Optional schema for tables dim_wafer / fact_* (default fabops)
# ADF_SQL_SCHEMA=fabops
